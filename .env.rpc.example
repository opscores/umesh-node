# ============================================================================
# .env.rpc.example — Docker compose environment template
# ---------------------------------------------------------------------------
# 1. cp .env.rpc.example .env.rpc
# 2. Edit the port/resource values below as needed.
# 3. Create your node YAML config from the template:
#    cp tools/umeshctl/examples/node-config/rpc.yaml ./config-rpc.yaml
#    nano ./config-rpc.yaml  (set chain, join sources, peers, telemetry)
# 4. Initialize:
#    umeshctl setup init --role rpc --config ./config-rpc.yaml \
#      --keyring-password-file ~/.umesh/keyring-pass
# 5. Start:
#    docker compose --env-file .env.rpc --profile rpc up -d
#
# This file contains ONLY docker-compose interpolation variables (ports,
# resources, image, labels). All initialization parameters live in the YAML
# config file used by `umeshctl setup init --config`.
# ============================================================================

# Docker image for all services
NODE_IMAGE=umesh-node:latest

# Docker labels
ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Host port bindings (compose)
# Inside the container ports are always standard (26656/26657/1317/9090/9091/26660);
# *_BIND_IP and *_PORT control host-side publication only.
# When changing public RPC/P2P ports, synchronize references in neighboring
# YAML configs (join.sentryRpc, network.persistentPeers).
# ----------------------------------------------------------------------------
RPC_P2P_BIND_IP="0.0.0.0"             # 26656 P2P
RPC_P2P_PORT=26656
RPC_RPC_BIND_IP="0.0.0.0"             # 26657 RPC
RPC_RPC_PORT=26657
RPC_REST_PORT=1317                    # REST
RPC_GRPC_PORT=9090                    # gRPC
RPC_GRPC_WEB_PORT=9091                # gRPC-Web
RPC_METRICS_BIND_IP="127.0.0.1"       # metrics: localhost only (change to 0.0.0.0 if remote)
RPC_METRICS_PORT=26660

# ----------------------------------------------------------------------------
# Container resource limits (compose)
# ----------------------------------------------------------------------------
CPU_LIMIT_RPC=2.0
MEMORY_LIMIT_RPC=8g
MEMORY_RESERVATION_RPC=4g
