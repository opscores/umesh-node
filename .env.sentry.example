# ============================================================================
# .env.sentry.example — Docker compose environment template
# ---------------------------------------------------------------------------
# 1. cp .env.sentry.example .env.sentry
# 2. Edit the port/resource values below as needed.
# 3. Create your node YAML config from the template:
#    cp tools/umeshctl/examples/node-config/sentry.yaml ./config-sentry.yaml
#    nano ./config-sentry.yaml  (set chain, join sources, peers, telemetry)
# 4. Initialize:
#    umeshctl setup init --role sentry --config ./config-sentry.yaml \
#      --keyring-password-file ~/.umesh/keyring-pass
# 5. Start:
#    docker compose --env-file .env.sentry --profile sentry up -d
#
# This file contains ONLY docker-compose interpolation variables (ports,
# resources, image, labels). All initialization parameters live in the YAML
# config file used by `umeshctl setup init --config`.
# ============================================================================

# Docker image for all services
NODE_IMAGE=umesh-node:latest

# Docker labels
ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Host port bindings (compose)
# Inside the container ports are always standard (26656/26657/1317/9090/9091/26658/26660);
# *_BIND_IP and *_PORT control host-side publication only.
# When changing public RPC/P2P ports, synchronize references in neighboring
# YAML configs (join.sentryRpc, join.validatorRpc, network.persistentPeers).
# ----------------------------------------------------------------------------
SENTRY_P2P_BIND_IP="0.0.0.0"          # 26656 P2P
SENTRY_P2P_PORT=26656
SENTRY_RPC_BIND_IP="0.0.0.0"          # 26657 RPC
SENTRY_RPC_PORT=26657
SENTRY_REST_PORT=1317                 # REST
SENTRY_GRPC_PORT=9090                 # gRPC
SENTRY_GRPC_WEB_PORT=9091             # gRPC-Web
SENTRY_METRICS_BIND_IP="127.0.0.1"     # metrics: localhost only (change to 0.0.0.0 if remote)
SENTRY_METRICS_PORT=26660
SENTRY_DC_BIND_IP="127.0.0.1"         # data companion: localhost only (debug endpoint)
SENTRY_DC_PORT=26658

# ----------------------------------------------------------------------------
# Container resource limits (compose)
# ----------------------------------------------------------------------------
CPU_LIMIT_SENTRY=2.0
MEMORY_LIMIT_SENTRY=8g
MEMORY_RESERVATION_SENTRY=4g
