# ============================================================================
# .env.validator.example — Docker compose environment template
# ---------------------------------------------------------------------------
# 1. cp .env.validator.example .env.validator
# 2. Edit the port/resource values below as needed.
# 3. Create your node YAML config from the template:
#    cp tools/umeshctl/examples/node-config/validator.yaml ./config-validator.yaml
#    nano ./config-validator.yaml  (set chain, join sources, peers, telemetry)
# 4. Initialize:
#    umeshctl setup init --role validator --config ./config-validator.yaml \
#      --keyring-password-file ~/.umesh/keyring-pass
# 5. Start:
#    docker compose --env-file .env.validator --profile validator up -d
#
# This file contains ONLY docker-compose interpolation variables (ports,
# resources, image, labels). All initialization parameters live in the YAML
# config file used by `umeshctl setup init --config`.
# ============================================================================

# Docker image for all services
NODE_IMAGE=umesh-node:latest

# Docker labels
ENVIRONMENT=production

# ----------------------------------------------------------------------------
# Host port bindings (compose)
# Inside the container ports are always 26656/26657/26660; *_BIND_IP and *_PORT
# control host-side publication only.
# ----------------------------------------------------------------------------
VALIDATOR_P2P_BIND_IP="0.0.0.0"        # 26656 P2P: bind on host
VALIDATOR_P2P_PORT=26656
VALIDATOR_RPC_BIND_IP="0.0.0.0"        # 26657 RPC: bind on host
VALIDATOR_RPC_PORT=26657               # RPC host port (Sentry/RPC from other VPS connect here)
VALIDATOR_METRICS_BIND_IP="127.0.0.1"        # metrics: localhost only (change to 0.0.0.0 if remote)
VALIDATOR_METRICS_PORT=26660

# ----------------------------------------------------------------------------
# Container resource limits (compose)
# Use CPU_LIMIT_VALIDATOR / MEMORY_LIMIT_VALIDATOR / MEMORY_RESERVATION_VALIDATOR
# to override per-role.
# ----------------------------------------------------------------------------
CPU_LIMIT=2.0
MEMORY_LIMIT=4g
MEMORY_RESERVATION=2g
